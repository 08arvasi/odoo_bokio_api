<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bokio_invoice_portal_rule" model="ir.rule">
        <field name="name">Bokio Invoice: portal users see own and company invoices</field>
        <field name="model_id" ref="invoice_bokio.model_bokio_invoice"/>
        <field name="domain_force">
            ['|',
             ('partner_id', '=', user.partner_id.id),
             ('partner_id', 'in', user.partner_id.parent_id.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
