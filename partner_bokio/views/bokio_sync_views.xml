<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Bokio Sync Status — list view showing all contacts and their Bokio sync state -->
  <record id="view_partner_bokio_sync_list" model="ir.ui.view">
    <field name="name">res.partner.bokio.sync.list</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <list string="Bokio Sync Status" default_order="name">
        <field name="name"/>
        <field name="is_company" widget="boolean_toggle" optional="show"/>
        <field name="email" optional="show"/>
        <field name="bokio_master" widget="badge"
               decoration-info="bokio_master == 'bokio'"
               decoration-success="bokio_master == 'odoo'"
               decoration-muted="bokio_master == 'none'"/>
        <field name="bokio_id" optional="show"/>
        <field name="bokio_customer_number" optional="show"/>
        <field name="bokio_synced_at" optional="show"/>
      </list>
    </field>
  </record>

  <!-- Search view: default filter = not yet synced to Bokio -->
  <record id="view_partner_bokio_sync_search" model="ir.ui.view">
    <field name="name">res.partner.bokio.sync.search</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <search string="Bokio Sync">
        <field name="name"/>
        <field name="bokio_id"/>
        <separator/>
        <filter string="Not synced" name="not_synced"
                domain="[('bokio_id', '=', False)]"/>
        <filter string="Synced" name="synced"
                domain="[('bokio_id', '!=', False)]"/>
        <filter string="Master: Bokio" name="master_bokio"
                domain="[('bokio_master', '=', 'bokio')]"/>
        <filter string="Master: Odoo" name="master_odoo"
                domain="[('bokio_master', '=', 'odoo')]"/>
        <filter string="Odoo only" name="master_none"
                domain="[('bokio_master', '=', 'none')]"/>
        <group name="group_by">
          <filter string="Master System" name="group_master"
                  context="{'group_by': 'bokio_master'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Kanban view: columns = Master System (Bokio | Odoo), drag to reassign -->
  <record id="view_partner_bokio_sync_kanban" model="ir.ui.view">
    <field name="name">res.partner.bokio.sync.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <kanban default_group_by="bokio_master" records_draggable="1">
        <field name="bokio_master"/>
        <field name="bokio_id"/>
        <field name="bokio_synced_at"/>
        <field name="is_company"/>
        <field name="email"/>
        <field name="phone"/>
        <templates>
          <t t-name="kanban-card">
            <div class="oe_kanban_global_click">
              <div class="o_kanban_record_top mb-1">
                <div class="o_kanban_record_headings">
                  <strong class="o_kanban_record_title fs-6">
                    <t t-if="record.is_company.value">🏢 </t>
                    <field name="name"/>
                  </strong>
                </div>
              </div>
              <div class="o_kanban_record_body text-muted small">
                <t t-if="record.email.value">
                  <div><i class="fa fa-envelope-o me-1"/><field name="email"/></div>
                </t>
                <t t-if="record.bokio_id.value">
                  <div class="text-success mt-1">
                    <i class="fa fa-check-circle me-1"/>
                    <field name="bokio_id"/>
                  </div>
                  <t t-if="record.bokio_synced_at.value">
                    <div class="text-muted" style="font-size:0.75rem">
                      <field name="bokio_synced_at" widget="datetime"/>
                    </div>
                  </t>
                </t>
                <t t-else="">
                  <div class="text-warning mt-1">
                    <i class="fa fa-exclamation-circle me-1"/>Not synced
                  </div>
                </t>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Window action -->
  <record id="action_partner_bokio_sync" model="ir.actions.act_window">
    <field name="name">Bokio Sync Status</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="view_id" eval="False"/>
    <field name="search_view_id" ref="view_partner_bokio_sync_search"/>
    <field name="context">{}</field>
    <field name="domain">[('type', '=', 'contact'), ('active', '=', True)]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        All contacts are synced with Bokio!
      </p>
      <p>
        Contacts missing a Bokio ID have not yet been synchronised.
        Run <code>sync_customers.py</code> or select records and use
        <strong>Actions → Sync to Bokio</strong>.
      </p>
    </field>
  </record>

</odoo>

