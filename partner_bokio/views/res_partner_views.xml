<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Bokio tab on the contact form -->
  <record id="view_partner_form_bokio" model="ir.ui.view">
    <field name="name">res.partner.form.bokio</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Bokio" name="bokio">
          <div class="mb-3">
            <button name="action_sync_to_bokio" type="object"
                    string="Sync to Bokio"
                    class="btn btn-primary"
                    invisible="bokio_master != 'odoo'"
                    title="Push Odoo data to Bokio"/>
            <button name="action_sync_to_bokio" type="object"
                    string="Sync to Odoo"
                    class="btn btn-primary"
                    invisible="bokio_master != 'bokio'"
                    title="Link Bokio UUID to this Odoo contact"/>
            <span invisible="bokio_master != 'none'"
                  class="text-muted fst-italic">
              This contact is Odoo only — not synced to Bokio.
            </span>
          </div>
          <group>
            <group string="Identification">
              <field name="bokio_id" readonly="1"/>
              <field name="bokio_customer_number" readonly="1"/>
            </group>
            <group string="Sync Status">
              <field name="bokio_master"/>
              <field name="bokio_synced_at" readonly="1"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
