<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- "Sync to Bokio" appears in the Actions menu when contacts are selected in list view -->
  <record id="action_sync_partner_to_bokio" model="ir.actions.server">
    <field name="name">Sync to Bokio</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="binding_model_id" ref="base.model_res_partner"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">records.action_sync_to_bokio()</field>
  </record>

  <!-- Contacts menu entry, scoped to this database's bokio.sync.contact_type -->
  <record id="action_open_bokio_contacts" model="ir.actions.server">
    <field name="name">Bokio kontakter</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_bokio_contacts()</field>
  </record>

  <!-- Bokio Sync Status menu entry, scoped to this database's bokio.sync.contact_type -->
  <record id="action_open_bokio_sync_status" model="ir.actions.server">
    <field name="name">Bokio Sync Status</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_bokio_sync_status()</field>
  </record>

</odoo>
