<?xml version="1.0" encoding="utf-8"?>
<!--
  noupdate="1" — mallen installeras vid första installation och skrivs sedan
  ALDRIG över vid uppgradering. Konfigurera avsändare, brödtext och signatur
  manuellt per databas via Odoo UI (Teknisk → E-post → Mallar).
-->
<odoo noupdate="1">
  <record id="mail_template_payment_confirmation" model="mail.template">
    <field name="name">Bokio: Betalningsbekräftelse</field>
    <field name="model_id" search="[('model', '=', 'bokio.invoice')]"/>
    <field name="subject">Tack för betalningen – faktura {{ object.bokio_invoice_number }}</field>

    <!-- Anpassa avsändare per databas -->
    <field name="email_from">ekonomi@arvas.international</field>
    <field name="email_to">{{ object.partner_id.email }}</field>

    <field name="body_html" type="html">
      <p>Hej <t t-esc="object.partner_id.name.split()[0]"/>,</p>

      <p>
        Vi har tagit emot din betalning på
        <strong>
          <t t-esc="'{:,.0f}'.format(object.amount_total).replace(',', ' ')"/>
          <t t-out="object.currency"/>
        </strong>
        för faktura <strong><t t-out="object.bokio_invoice_number"/></strong>.
        Tack — det uppskattas!
      </p>

      <p>
        Hör gärna av dig om du har några frågor.
      </p>

      <p>
        Mvh,<br/>
        <!-- Anpassa signatur per databas -->
        Fredrik Arvas<br/>
        Arvas International AB
      </p>
    </field>

    <field name="auto_delete">True</field>
  </record>

  <record id="mail_template_partner_statement" model="mail.template">
    <field name="name">Bokio: Fakturautdrag</field>
    <field name="model_id" search="[('model', '=', 'res.partner')]"/>
    <field name="subject">Fakturautdrag – {{ object.name }}</field>
    <field name="email_from">ekonomi@arvas.international</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="report_template_ids" eval="[(4, ref('invoice_bokio.action_report_bokio_partner_statement'))]"/>
    <field name="auto_delete">False</field>
    <field name="body_html" type="html">
      <p>Hej <t t-esc="(object.name or '').split()[0]"/>,</p>

      <p>
        Bifogat finner du ett sammanställt fakturautdrag.
      </p>

      <p>
        Hör gärna av dig om du har frågor.
      </p>

      <p>
        Allt gott!<br/>
        Fredrik Arvas<br/>
        Arvas International AB<br/>
        070-814 55 95 · fredrik@arvas.se
      </p>
    </field>
  </record>
</odoo>
