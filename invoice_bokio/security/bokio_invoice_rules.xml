<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="bokio_invoice_contact_type_rule" model="ir.rule">
    <field name="name">Bokio Invoice: scope to this database's Bokio contact type</field>
    <field name="model_id" ref="invoice_bokio.model_bokio_invoice"/>
    <field name="domain_force">[('bokio_visible', '=', True)]</field>
    <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>

  <!-- base.group_system implies base.group_user, so without this exemption
       admins would also be scoped by the rule above — Odoo ORs rules across
       the groups a user belongs to, so this unrestricted rule cancels the
       scoping rule out for anyone in group_system, while regular internal
       users (e.g. Jessica, who is only group_user) stay scoped. -->
  <record id="bokio_invoice_contact_type_admin_bypass_rule" model="ir.rule">
    <field name="name">Bokio Invoice: admins see every Bokio context</field>
    <field name="model_id" ref="invoice_bokio.model_bokio_invoice"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(6, 0, [ref('base.group_system')])]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>

</odoo>
