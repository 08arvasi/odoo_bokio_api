<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_bokio_sync_log_list" model="ir.ui.view">
    <field name="name">bokio.sync.log.list</field>
    <field name="model">bokio.sync.log</field>
    <field name="arch" type="xml">
      <list string="Bokio Sync Log" default_order="sync_time desc">
        <field name="sync_time"/>
        <field name="status" widget="badge"
               decoration-success="status == 'success'"
               decoration-warning="status == 'partial'"
               decoration-danger="status == 'failed'"/>
        <field name="invoices_fetched"/>
        <field name="invoices_created"/>
        <field name="invoices_updated"/>
        <field name="confirmations_sent"/>
        <field name="errors" optional="show"/>
      </list>
    </field>
  </record>

  <record id="action_bokio_sync_log" model="ir.actions.act_window">
    <field name="name">Bokio Sync Log</field>
    <field name="res_model">bokio.sync.log</field>
    <field name="view_mode">list</field>
  </record>

</odoo>
